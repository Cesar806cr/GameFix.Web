@model Gamefix.Application.DTOs.BloqueoHorarioDTO
<h1>Detalle</h1>
<h4>Bloqueo de horario</h4>
<hr />
<dl class="row"><dt class="col-sm-3">Fechas</dt><dd class="col-sm-9">@Model.FechaInicio.ToString("dd/MM/yyyy") - @Model.FechaFin.ToString("dd/MM/yyyy")</dd><dt class="col-sm-3">Horario</dt><dd class="col-sm-9">@(Model.HoraInicio is null ? "Todo el día" : $"{Model.HoraInicio:HH:mm} - {Model.HoraFin:HH:mm}")</dd><dt class="col-sm-3">Motivo</dt><dd class="col-sm-9">@Model.Motivo</dd></dl>
<a asp-action="Index" asp-route-sucursalId="@Model.SucursalId" class="btn btn-maintenance-back"><i class="bi bi-arrow-left"></i> Regresar al listado</a>
