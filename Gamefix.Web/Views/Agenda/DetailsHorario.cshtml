@model Gamefix.Application.DTOs.HorarioSucursalDTO
@{
    var dias = new[] { "", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado" };
}
<h1>Detalle</h1>
<h4>Horario semanal</h4>
<hr />
<dl class="row"><dt class="col-sm-3">Día</dt><dd class="col-sm-9">@dias[Model.DiaSemana]</dd><dt class="col-sm-3">Apertura</dt><dd class="col-sm-9">@Model.HoraApertura.ToString("HH:mm")</dd><dt class="col-sm-3">Cierre</dt><dd class="col-sm-9">@Model.HoraCierre.ToString("HH:mm")</dd></dl>
<a asp-action="Index" asp-route-sucursalId="@Model.SucursalId" class="btn btn-maintenance-back"><i class="bi bi-arrow-left"></i> Regresar al listado</a>
