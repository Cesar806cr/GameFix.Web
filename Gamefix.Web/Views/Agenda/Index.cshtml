@model Gamefix.Application.DTOs.AgendaSucursalDTO
@{
    ViewData["Title"] = "Horarios y bloqueos";
    var sucursales = ViewBag.Sucursales as IEnumerable<Gamefix.Application.DTOs.SucursalDTO> ?? [];
    var nombresDias = new[] { "", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado" };
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Horarios y bloqueos</h1>
        <p class="text-secondary mb-0">Calendario de @Model.NombreSucursal</p>
    </div>
    @if (Model.SucursalId > 0) {
        <div>
            <a asp-action="CreateHorario" asp-route-sucursalId="@Model.SucursalId" class="btn btn-primary">Nuevo horario</a>
            <a asp-action="CreateBloqueo" asp-route-sucursalId="@Model.SucursalId" class="btn btn-primary">Nuevo bloqueo</a>
        </div>
    }
</div>
<form asp-action="Index" method="get" class="mb-4">
    <label class="form-label">Sucursal</label>
    <select name="sucursalId" class="form-select agenda-sucursal-select" onchange="this.form.submit()">
        @foreach (var sucursal in sucursales) { <option value="@sucursal.SucursalId" selected="@(sucursal.SucursalId == Model.SucursalId)">@sucursal.Nombre</option> }
    </select>
</form>
<div class="row g-4">
    <div class="col-lg-6">
        <div class="card"><div class="card-header">Horarios de servicio</div><div class="card-body">
            @if (Model.Horarios.Count == 0) { <p class="text-muted">No hay horarios registrados.</p> }
            else { <table class="table"><thead><tr><th>Día</th><th>Apertura</th><th>Cierre</th><th></th></tr></thead><tbody>
                @foreach (var item in Model.Horarios) { <tr><td>@nombresDias[item.DiaSemana]</td><td>@item.HoraApertura.ToString("HH:mm")</td><td>@item.HoraCierre.ToString("HH:mm")</td><td><a asp-action="DetailsHorario" asp-route-id="@item.HorarioSucursalId">Detalle</a></td></tr> }
            </tbody></table> }
        </div></div>
    </div>
    <div class="col-lg-6">
        <div class="card"><div class="card-header">Bloqueos</div><div class="card-body">
            @if (Model.Bloqueos.Count == 0) { <p class="text-muted">No hay bloqueos registrados.</p> }
            else { <table class="table"><thead><tr><th>Fecha</th><th>Horario</th><th>Motivo</th><th></th></tr></thead><tbody>
                @foreach (var item in Model.Bloqueos) { <tr><td>@item.FechaInicio.ToString("dd/MM/yyyy") - @item.FechaFin.ToString("dd/MM/yyyy")</td><td>@(item.HoraInicio is null ? "Todo el día" : $"{item.HoraInicio:HH:mm} - {item.HoraFin:HH:mm}")</td><td>@item.Motivo</td><td><a asp-action="DetailsBloqueo" asp-route-id="@item.BloqueoHorarioId">Detalle</a></td></tr> }
            </tbody></table> }
        </div></div>
    </div>
</div>
