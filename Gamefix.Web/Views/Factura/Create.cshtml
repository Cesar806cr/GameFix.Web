@using System.Text.Json
@model Gamefix.Application.DTOs.FacturaFormularioDTO

@{
    ViewData["Title"] = "Registrar factura";
    var servicios = Model.Servicios.Select(item => new { id = item.ServicioId, nombre = item.Nombre, precio = item.Precio, tipo = "servicio" });
    var productos = Model.Productos.Select(item => new { id = item.ProductoId, nombre = item.Nombre, precio = item.Precio, tipo = "producto" });
}

<div class="maintenance-form-page">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Registrar factura</h1>
            <p class="text-secondary mb-0">Comprobante de la sucursal del encargado.</p>
        </div>
        <div class="text-end">
            <span class="badge bg-info fs-6 d-block mb-1">@Model.SucursalNombre</span>
            <span class="badge bg-secondary fs-6">Fecha: @DateTime.Today.ToString("dd/MM/yyyy")</span>
        </div>
    </div>

    <form asp-action="Create" method="post" class="maintenance-form" id="facturaForm" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="Factura.ReservaId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="maintenance-section">Encabezado</div>
        <div class="row">
            <div class="col-md-6 form-group">
                <label asp-for="Factura.ClienteId" class="form-label">Cliente</label>
                <select asp-for="Factura.ClienteId" class="form-select" id="clienteFactura">
                    <option value="0">Seleccione un cliente</option>
                    @foreach (var cliente in Model.Clientes)
                    {
                        <option value="@cliente.UsuarioId" data-email="@cliente.CorreoElectronico">@cliente.Nombre</option>
                    }
                </select>
                <span asp-validation-for="Factura.ClienteId" class="text-danger"></span>
                <div id="correoCliente" class="form-text">Seleccione un cliente para ver su correo.</div>
            </div>
            <div class="col-md-6 form-group">
                <label class="form-label">Encargado</label>
                <input class="form-control" value="@Model.EncargadoNombre" readonly />
            </div>
            <input asp-for="Factura.EstadoFactura" type="hidden" />
        </div>

        <div class="maintenance-section d-flex justify-content-between align-items-center">
            <span>Detalle de la factura</span>
            <button type="button" class="btn btn-outline-info btn-sm" id="agregarLinea">
                <i class="bi bi-plus-circle"></i> Agregar línea
            </button>
        </div>
        <div id="facturaLineasError" class="text-danger mb-2"></div>
        <div class="table-responsive">
            <table class="table align-middle" id="tablaLineas">
                <thead>
                    <tr>
                        <th>Servicio y producto adicional</th>
                        <th style="width: 180px;">Cantidad</th>
                        <th class="text-end">Subtotal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div class="row justify-content-end">
            <div class="col-md-5">
                <dl class="row">
                    <dt class="col-7">Subtotal</dt>
                    <dd class="col-5 text-end" id="subtotal">₡0</dd>
                    <dt class="col-7">Impuesto (13%)</dt>
                    <dd class="col-5 text-end" id="impuesto">₡0</dd>
                    <dt class="col-7 fs-5">Total</dt>
                    <dd class="col-5 text-end fs-5 fw-bold" id="total">₡0</dd>
                </dl>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-maintenance-back">
                <i class="bi bi-arrow-left"></i> Regresar
            </a>
            <button type="submit" class="btn btn-primary">Registrar factura</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const serviciosFactura = @Html.Raw(JsonSerializer.Serialize(servicios));
        const productosFactura = @Html.Raw(JsonSerializer.Serialize(productos));
        const lineasIniciales = @Html.Raw(JsonSerializer.Serialize(Model.Factura.Lineas));
        const formatoMoneda = value => `₡${Number(value).toLocaleString('es-CR', { maximumFractionDigits: 2 })}`;

        function serviciosHtml(valor) {
            return `<option value="">Seleccione un servicio</option>` +
                serviciosFactura.map(item =>
                    `<option value="${item.id}" data-price="${item.precio}" ${valor === item.id ? 'selected' : ''}>${item.nombre}</option>`
                ).join('');
        }

        function productosHtml(valor) {
            return `<option value="">Ninguno</option>` +
                productosFactura.map(item =>
                    `<option value="${item.id}" data-price="${item.precio}" ${valor === item.id ? 'selected' : ''}>${item.nombre}</option>`
                ).join('');
        }

        function recalcular() {
            let subtotal = 0;
            document.querySelectorAll('#tablaLineas tbody tr').forEach(row => {
                const servicioOption = row.querySelector('.linea-servicio option:checked');
                const productoOption = row.querySelector('.linea-producto option:checked');
                const cantidadServicio = Number(row.querySelector('.cantidad-servicio').value || 0);
                const cantidadProducto = Number(row.querySelector('.cantidad-producto').value || 0);
                const subtotalServicio =
                    Number(servicioOption?.dataset.price || 0) * cantidadServicio;
                const subtotalProducto =
                    Number(productoOption?.dataset.price || 0) * cantidadProducto;
                const parcial = subtotalServicio + subtotalProducto;
                subtotal += parcial;
                row.querySelector('.linea-subtotal').textContent = formatoMoneda(parcial);
            });
            const impuesto = subtotal * 0.13;
            document.getElementById('subtotal').textContent = formatoMoneda(subtotal);
            document.getElementById('impuesto').textContent = formatoMoneda(impuesto);
            document.getElementById('total').textContent = formatoMoneda(subtotal + impuesto);
        }

        function agregarLinea(servicioId = 0, productoId = 0, cantidad = 1) {
            const row = document.createElement('tr');
            row.innerHTML = `
                <td>
                    <select class="form-select linea-servicio mb-2">${serviciosHtml(servicioId)}</select>
                    <select class="form-select linea-producto">${productosHtml(productoId)}</select>
                </td>
                <td>
                    <label class="form-label small mb-1">Servicio</label>
                    <input type="number" min="1" max="9999" step="1" value="${cantidad}"
                           class="form-control cantidad-servicio mb-2" />
                    <label class="form-label small mb-1">Producto</label>
                    <input type="number" min="0" step="1" value="${cantidad}"
                           class="form-control cantidad-producto" />
                </td>
                <td class="text-end linea-subtotal">₡0</td>
                <td><button type="button" class="btn btn-outline-danger btn-sm quitar-linea"><i class="bi bi-trash"></i></button></td>`;
            document.querySelector('#tablaLineas tbody').appendChild(row);
            row.querySelector('.linea-servicio').addEventListener('change', recalcular);
            row.querySelector('.linea-producto').addEventListener('change', recalcular);
            row.querySelector('.cantidad-servicio').addEventListener('input', recalcular);
            row.querySelector('.cantidad-producto').addEventListener('input', recalcular);
            row.querySelector('.quitar-linea').addEventListener('click', () => {
                row.remove();
                recalcular();
            });
            recalcular();
        }

        document.getElementById('agregarLinea').addEventListener('click', () => agregarLinea());
        document.getElementById('clienteFactura').addEventListener('change', event => {
            const option = event.target.options[event.target.selectedIndex];
            document.getElementById('correoCliente').textContent =
                option.dataset.email ? `Correo: ${option.dataset.email}` : 'Seleccione un cliente para ver su correo.';
        });

        if (lineasIniciales.length > 0) {
            lineasIniciales.forEach(linea => agregarLinea(
                linea.servicioId || 0,
                linea.productoId || 0,
                linea.cantidad));
            recalcular();
        } else {
            agregarLinea();
        }

        document.getElementById('facturaForm').addEventListener('submit', event => {
            document.querySelectorAll('.linea-submit').forEach(input => input.remove());
            let indice = 0;
            let tieneServicioValido = false;
            let tieneCantidadInvalida = false;

            document.querySelectorAll('#tablaLineas tbody tr').forEach(row => {
                const servicioId = row.querySelector('.linea-servicio').value;
                const productoId = row.querySelector('.linea-producto').value;
                const cantidadServicio = Number(row.querySelector('.cantidad-servicio').value || 0);
                const cantidadProducto = Number(row.querySelector('.cantidad-producto').value || 0);

                if (servicioId && cantidadServicio >= 1)
                    tieneServicioValido = true;
                if ((servicioId && (!Number.isInteger(cantidadServicio) || cantidadServicio < 1 || cantidadServicio > 9999)) ||
                    (productoId && (!Number.isInteger(cantidadProducto) || cantidadProducto < 1 || cantidadProducto > 9999)))
                    tieneCantidadInvalida = true;

                if (servicioId && cantidadServicio > 0) {
                    row.insertAdjacentHTML('beforeend',
                        `<input class="linea-submit" type="hidden" name="Factura.Lineas[${indice}].ServicioId" value="${servicioId}" />
                         <input class="linea-submit" type="hidden" name="Factura.Lineas[${indice}].Cantidad" value="${cantidadServicio}" />`);
                    indice++;
                }
                if (productoId && cantidadProducto > 0) {
                    row.insertAdjacentHTML('beforeend',
                        `<input class="linea-submit" type="hidden" name="Factura.Lineas[${indice}].ProductoId" value="${productoId}" />
                         <input class="linea-submit" type="hidden" name="Factura.Lineas[${indice}].Cantidad" value="${cantidadProducto}" />`);
                    indice++;
                }
            });

            if (!tieneServicioValido || tieneCantidadInvalida) {
                event.preventDefault();
                document.getElementById('facturaLineasError').textContent =
                    tieneCantidadInvalida
                        ? 'La cantidad debe ser un número entero entre 1 y 9999.'
                        : 'Seleccione al menos un servicio y coloque una cantidad válida.';
            } else {
                document.getElementById('facturaLineasError').textContent = '';
            }
        });
    </script>
}
