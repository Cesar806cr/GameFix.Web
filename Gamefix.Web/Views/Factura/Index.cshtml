@model IEnumerable<Gamefix.Application.DTOs.FacturaDTO>

@{
    ViewData["Title"] = "Facturación";
}

<h1>Historial de facturación</h1>

<table class="table table-hover align-middle mt-4">
    <thead>
        <tr>
            <th>Número</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NumeroFactura</td>
                <td>@item.FechaEmision.ToString("dd-MM-yyyy")</td>
                <td>@item.ClienteNombre</td>
                <td>@item.Total.ToString("C")</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.FacturaId"
                       class="btn btn-info btn-sm">
                        <i class="bi bi-eye"></i>
                        Detalle
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
