@{
    Layout = "_Layout";
    ViewData["Title"] = "Inicio";
}

<div id="gamefixCarrusel"
     class="carousel slide pt-3"
     data-bs-ride="carousel">

    <div class="carousel-indicators">
        <button type="button"
                data-bs-target="#gamefixCarrusel"
                data-bs-slide-to="0"
                class="active"
                aria-current="true"
                aria-label="Diapositiva 1">
        </button>

        <button type="button"
                data-bs-target="#gamefixCarrusel"
                data-bs-slide-to="1"
                aria-label="Diapositiva 2">
        </button>

        <button type="button"
                data-bs-target="#gamefixCarrusel"
                data-bs-slide-to="2"
                aria-label="Diapositiva 3">
        </button>
    </div>

    <div class="carousel-inner rounded shadow">

        <div class="carousel-item active">
            <img src="~/images/slide-1.png"
                 class="d-block w-100"
                 alt="Productos gamer"
                 height="500">

            <div class="carousel-caption d-none d-md-block">
                <h5>Productos gamer</h5>
                <p>Encuentra consolas, accesorios y productos para videojuegos.</p>
            </div>
        </div>

        <div class="carousel-item">
            <img src="~/images/slide-2.png"
                 class="d-block w-100"
                 alt="Reparación de consolas"
                 height="500">

            <div class="carousel-caption d-none d-md-block">
                <h5>Reparación de consolas</h5>
                <p>Servicio técnico para mantener tus equipos en buen estado.</p>
            </div>
        </div>

        <div class="carousel-item">
            <img src="~/images/slide-3.png"
                 class="d-block w-100"
                 alt="Compra segura"
                 height="500">

            <div class="carousel-caption d-none d-md-block">
                <h5>Compra segura</h5>
                <p>Adquiere tus productos de forma rápida y segura.</p>
            </div>
        </div>

    </div>

    <button class="carousel-control-prev"
            type="button"
            data-bs-target="#gamefixCarrusel"
            data-bs-slide="prev">
        <span class="carousel-control-prev-icon"
              aria-hidden="true">
        </span>

        <span class="visually-hidden">
            Anterior
        </span>
    </button>

    <button class="carousel-control-next"
            type="button"
            data-bs-target="#gamefixCarrusel"
            data-bs-slide="next">
        <span class="carousel-control-next-icon"
              aria-hidden="true">
        </span>

        <span class="visually-hidden">
            Siguiente
        </span>
    </button>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const carouselElement =
                document.getElementById("gamefixCarrusel");

            new bootstrap.Carousel(carouselElement, {
                interval: 3000,
                ride: "carousel"
            });
        });
    </script>
}