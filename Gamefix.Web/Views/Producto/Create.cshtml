@model Gamefix.Application.DTOs.ProductoDTO
@{
    ViewData["Title"] = "Crear producto";
}
<div class="maintenance-form-page">
    <h1>Crear producto</h1>
    <h4>Agrega un artículo al inventario.</h4>
    <form asp-action="Create" asp-antiforgery="true" method="post" enctype="multipart/form-data" class="maintenance-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="maintenance-section">Información general</div>
        <div class="row">
            <div class="col-md-6 form-group">
                <label asp-for="Nombre" class="control-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="col-md-6 form-group">
                <label asp-for="CategoriaProductoId" class="control-label">Categoría</label>
                <select asp-for="CategoriaProductoId" class="form-select" asp-items="@(new SelectList(ViewBag.Categorias, "CategoriaProductoId", "Nombre"))">
                    <option value="">Seleccione una categoría</option>
                </select>
                <span asp-validation-for="CategoriaProductoId" class="text-danger"></span>
            </div>
            <div class="col-12 form-group">
                <label asp-for="Descripcion" class="control-label"></label>
                <textarea asp-for="Descripcion" class="form-control"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
        </div>
        <div class="maintenance-section">Detalles comerciales</div>
        <div class="row">
            <div class="col-md-4 form-group"><label asp-for="Precio" class="control-label"></label><input asp-for="Precio" class="form-control" type="number" step="0.01" /><span asp-validation-for="Precio" class="text-danger"></span></div>
            <div class="col-md-4 form-group"><label asp-for="Marca" class="control-label"></label><input asp-for="Marca" class="form-control" /><span asp-validation-for="Marca" class="text-danger"></span></div>
            <div class="col-md-4 form-group"><label asp-for="Compatibilidad" class="control-label"></label><input asp-for="Compatibilidad" class="form-control" /><span asp-validation-for="Compatibilidad" class="text-danger"></span></div>
        </div>
        <div class="maintenance-section">Inventario</div>
        <div class="row">
            <div class="col-md-4 form-group"><label asp-for="Existencia" class="control-label"></label><input asp-for="Existencia" class="form-control" /><span asp-validation-for="Existencia" class="text-danger"></span></div>
            <div class="col-md-4 form-group"><label asp-for="StockMinimo" class="control-label">Existencia mínima</label><input asp-for="StockMinimo" class="form-control" /><span asp-validation-for="StockMinimo" class="text-danger"></span></div>
        </div>
        <div class="maintenance-section">Imagen</div>
        <div class="maintenance-image-box">
            <label for="imageFile" class="visually-hidden">Imagen producto</label>
            <input id="imageFile" name="imageFile" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
            <span class="form-text">Formatos permitidos: JPG, PNG o WEBP. Máximo 5 MB.</span>
            <span asp-validation-for="Imagen" class="text-danger"></span>
        </div>
        <div class="form-actions">
            <a asp-action="IndexAdmin" class="btn btn-maintenance-back"><i class="bi bi-arrow-left"></i> Regresar al listado</a>
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
