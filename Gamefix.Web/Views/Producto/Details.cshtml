@model Gamefix.Application.DTOs.ProductoDTO

@{
    ViewData["Title"] = "Detalle del producto";
}

<h1>Detalle del producto</h1>

<div class="row g-4 mt-1">
    <div class="col-md-5">
        @if (Model.Imagen is not null && Model.Imagen.Length > 0)
        {
            <img class="img-fluid rounded shadow-sm product-detail-image"
                 src="data:@Model.TipoImagen;base64,@Convert.ToBase64String(Model.Imagen)"
                 alt="@Model.Nombre" />
        }
        else
        {
            <div class="product-detail-image product-image-placeholder rounded shadow-sm">
                <i class="bi bi-controller fs-1"></i>
                <span>Imagen pendiente</span>
            </div>
        }
    </div>
    <div class="col-md-7">
        <h2>@Model.Nombre</h2>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">Descripción</dt>
            <dd class="col-sm-8">@Model.Descripcion</dd>
            <dt class="col-sm-4">Categoría</dt>
            <dd class="col-sm-8">@Model.CategoriaNombre</dd>
            <dt class="col-sm-4">Marca</dt>
            <dd class="col-sm-8">@Model.Marca</dd>
            <dt class="col-sm-4">Compatibilidad</dt>
            <dd class="col-sm-8">@Model.Compatibilidad</dd>
            <dt class="col-sm-4">Precio</dt>
            <dd class="col-sm-8">₡@Model.Precio.ToString("#,##0")</dd>
            <dt class="col-sm-4">Existencia</dt>
            <dd class="col-sm-8">@Model.Existencia</dd>
            <dt class="col-sm-4">Existencia mínima</dt>
            <dd class="col-sm-8">@Model.StockMinimo</dd>
        </dl>
    </div>
</div>

<a asp-action="Index" class="btn btn-info mt-3">
    <i class="bi bi-arrow-return-left"></i>
    Regresar al listado
</a>
