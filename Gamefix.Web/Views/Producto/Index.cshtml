@model IEnumerable<Gamefix.Application.DTOs.ProductoDTO>

@{
    ViewData["Title"] = "Productos";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-controller="Producto"
       asp-action="Create"
       class="btn btn-primary">
        <i class="bi bi-plus-circle"></i>
        Crear producto
    </a>
</p>

<div class="row mb-3">
    <div class="col-md-12">
        <a class="btn btn-success"
           asp-controller="Producto"
           asp-action="Enviar">
            <i class="bi bi-send"></i>
            Enviar
        </a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.ProductoId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Nombre)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Marca)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Precio)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Existencia)
                </th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductoId)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Marca)
                    </td>

                    <td>
                        @item.Precio.ToString("C")
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Existencia)
                    </td>

                    <td>
                        <a class="btn btn-warning btn-sm"
                           asp-controller="Producto"
                           asp-action="Edit"
                           asp-route-id="@item.ProductoId">
                            <i class="bi bi-pencil"></i>
                            Editar
                        </a>

                        <a class="btn btn-info btn-sm"
                           asp-controller="Producto"
                           asp-action="Details"
                           asp-route-id="@item.ProductoId">
                            <i class="bi bi-eye"></i>
                            Detalles
                        </a>

                        <a class="btn btn-danger btn-sm"
                           asp-controller="Producto"
                           asp-action="Delete"
                           asp-route-id="@item.ProductoId">
                            <i class="bi bi-trash"></i>
                            Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>