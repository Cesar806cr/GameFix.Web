@model Gamefix.Application.DTOs.ReservaDTO

@{
    ViewData["Title"] = "Detalle de reserva";
}

<h1>Detalle de la reserva</h1>

<div class="card shadow-sm mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0">@Model.CodigoReserva</h4>
        <span class="badge reservation-status"
              style="background-color:@Model.EstadoColor">
            @Model.EstadoNombre
        </span>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Fecha de registro</dt>
            <dd class="col-sm-8">@Model.FechaRegistro.ToString("dd-MM-yyyy HH:mm")</dd>
            <dt class="col-sm-4">Inicio</dt>
            <dd class="col-sm-8">@Model.FechaHoraInicio.ToString("dd-MM-yyyy HH:mm")</dd>
            <dt class="col-sm-4">Fin</dt>
            <dd class="col-sm-8">@Model.FechaHoraFin.ToString("dd-MM-yyyy HH:mm")</dd>
            <dt class="col-sm-4">Sucursal</dt>
            <dd class="col-sm-8">@Model.SucursalNombre</dd>
            <dt class="col-sm-4">Servicio</dt>
            <dd class="col-sm-8">@Model.ServicioNombre</dd>
            <dt class="col-sm-4">Cliente</dt>
            <dd class="col-sm-8">@Model.ClienteNombre</dd>
        </dl>

        <h5 class="border-bottom pb-2 mt-4">Información de la consola</h5>
        <dl class="row">
            <dt class="col-sm-4">Tipo de consola</dt>
            <dd class="col-sm-8">@Model.TipoConsola</dd>
            <dt class="col-sm-4">Problema reportado</dt>
            <dd class="col-sm-8">@Model.ProblemaReportado</dd>
            <dt class="col-sm-4">¿Enciende correctamente?</dt>
            <dd class="col-sm-8">@(Model.EnciendeCorrectamente ? "Sí" : "No")</dd>
            <dt class="col-sm-4">¿Fue reparada anteriormente?</dt>
            <dd class="col-sm-8">@(Model.FueReparadaAnteriormente ? "Sí" : "No")</dd>
            <dt class="col-sm-4">¿Hace algún ruido extraño la lectora al meter el disco?</dt>
            <dd class="col-sm-8">@(Model.HaceRuidoLectora ? "Sí" : "No")</dd>
            <dt class="col-sm-4">Observaciones</dt>
            <dd class="col-sm-8">@(Model.ObservacionesCliente ?? "Sin observaciones")</dd>
        </dl>
    </div>
</div>

<a asp-action="Index" class="btn btn-info mt-3">
    <i class="bi bi-arrow-return-left"></i>
    Regresar al listado
</a>
