@model IEnumerable<Gamefix.Application.DTOs.ReservaDTO>
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Reservas";
}

<div class="d-flex justify-content-between align-items-center">
    <h1>Historial de reservas</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-calendar-plus"></i> Registrar reserva
    </a>
</div>

<form asp-action="Index" method="get" class="card card-body mt-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Cliente</label>
            <select name="clienteId" class="form-select">
                <option value="">Todos los clientes</option>
                @foreach (var cliente in (IEnumerable<Gamefix.Application.DTOs.UsuarioOpcionDTO>)ViewBag.Clientes)
                {
                    <option value="@cliente.UsuarioId" selected="@(cliente.UsuarioId == (int?)ViewBag.ClienteId)">
                        @cliente.Nombre
                    </option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Fecha</label>
            <input type="date" name="fecha" value="@ViewBag.Fecha" class="form-control" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-info flex-fill">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </div>
</form>

<table class="table table-hover align-middle mt-4">
    <thead>
        <tr>
            <th>Código</th>
            <th>Fecha y Hora</th>
            <th>Cliente</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CodigoReserva</td>
                <td>@item.FechaHoraInicio.ToString("dd-MM-yyyy HH:mm")</td>
                <td>@item.ClienteNombre</td>
                <td>
                    <span class="badge reservation-status"
                          style="background-color:@item.EstadoColor">
                        @item.EstadoNombre
                    </span>
                </td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.ReservaId"
                       class="btn btn-info btn-sm">
                        Detalle
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-end">
    @Html.PagedListPager((IPagedList)Model, page =>
             Url.Action("Index", new { page, clienteId = ViewBag.ClienteId, fecha = ViewBag.Fecha }), new PagedListRenderOptions
    {
        Display = PagedListDisplayMode.Always,
        MaximumPageNumbersToDisplay = 5,
        LiElementClasses = new[] { "page-item" },
        PageClasses = new[] { "page-link" }
    })
</div>
