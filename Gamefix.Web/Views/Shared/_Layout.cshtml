<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Gamefix</title>

    @* Tema Cyborg *@
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/cyborg/bootstrap.min.css" />

    @* Estilos propios *@
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @* Bootstrap Icons *@
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @* SweetAlert *@
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.4/dist/sweetalert2.min.css" />
</head>

<body class="d-flex flex-column min-vh-100">

    <header>
        @await Html.PartialAsync("_Menu")
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-auto bg-dark text-light border-top py-3">
        <div class="container">
            &copy; @DateTime.Now.Year - Gamefix -
            <a class="text-info"
               asp-controller="Home"
               asp-action="Privacy">
                Privacidad
            </a>
        </div>
    </footer>

    @* jQuery *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    @* Bootstrap JavaScript *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @* SweetAlert *@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.4/dist/sweetalert2.all.min.js"></script>

    @* JavaScript propio *@
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @* Scripts específicos de cada vista *@
    @await RenderSectionAsync("Scripts", required: false)

    @* Notificaciones *@
    @if (ViewBag.NotificationMessage != null)
    {
        <script>
            @Html.Raw(ViewBag.NotificationMessage)
        </script>
    }
</body>
</html>