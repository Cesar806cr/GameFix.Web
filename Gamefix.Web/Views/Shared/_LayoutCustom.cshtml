<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Gamefix</title>

    @* Tema Cyborg *@
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/cyborg/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @* Bootstrap Icons *@
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>
    <div class="container-fluid">
        <div class="row flex-nowrap min-vh-100">

            @* Menú lateral *@
            <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 bg-black">
                <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 text-white min-vh-100">

                    @* Logo *@
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="d-flex align-items-center pb-3 mb-md-0 me-md-auto text-white text-decoration-none">

                        <i class="bi bi-controller fs-4"></i>
                        <span class="fs-5 d-none d-sm-inline ms-2">
                            Gamefix
                        </span>
                    </a>

                    <hr class="w-100" />

                    <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start w-100"
                        id="menu">

                        @* Inicio *@
                        <li class="nav-item w-100">
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="nav-link text-white px-0 align-middle">

                                <i class="fs-4 bi-house"></i>
                                <span class="ms-1 d-none d-sm-inline">
                                    Inicio
                                </span>
                            </a>
                        </li>

                        @* Mantenimiento *@
                        <li class="w-100">
                            <a href="#submenuMantenimiento"
                               data-bs-toggle="collapse"
                               class="nav-link text-white px-0 align-middle">

                                <i class="fs-4 bi-tools"></i>
                                <span class="ms-1 d-none d-sm-inline">
                                    Mantenimiento
                                </span>
                            </a>

                            <ul class="collapse nav flex-column ms-1"
                                id="submenuMantenimiento"
                                data-bs-parent="#menu">
                                <li class="w-100">
                                    <a asp-controller="Producto"
                                       asp-action="IndexAdmin"
                                       class="nav-link text-white px-0">

                                        <i class="bi bi-box-seam"></i>
                                        <span class="d-none d-sm-inline ms-1">
                                            Productos
                                        </span>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        @* Procesos *@
                        <li class="w-100">
                            <a href="#submenuProcesos"
                               data-bs-toggle="collapse"
                               class="nav-link text-white px-0 align-middle">

                                <i class="fs-4 bi-gear-fill"></i>
                                <span class="ms-1 d-none d-sm-inline">
                                    Procesos
                                </span>
                            </a>

                            <ul class="collapse show nav flex-column ms-1"
                                id="submenuProcesos"
                                data-bs-parent="#menu">

                                <li class="w-100">
                                    <a asp-controller="Factura"
                                       asp-action="Index"
                                       class="nav-link text-white px-0">

                                        <i class="bi bi-receipt"></i>
                                        <span class="d-none d-sm-inline ms-1">
                                            Facturación
                                        </span>
                                    </a>
                                </li>

                                <li class="w-100">
                                    <a asp-controller="Reserva"
                                       asp-action="Index"
                                       class="nav-link text-white px-0">

                                        <i class="bi bi-calendar-check"></i>
                                        <span class="d-none d-sm-inline ms-1">
                                            Reservas
                                        </span>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        @* Información *@
                        <li class="nav-item w-100">
                            <a asp-controller="Home"
                               asp-action="Privacy"
                               class="nav-link text-white px-0 align-middle">

                                <i class="fs-4 bi-shield-lock"></i>
                                <span class="ms-1 d-none d-sm-inline">
                                    Privacidad
                                </span>
                            </a>
                        </li>
                    </ul>

                    <hr class="w-100" />

                    @* Usuario *@
                    <div class="dropdown pb-4 w-100">
                        <a href="#"
                           class="d-flex align-items-center text-white text-decoration-none dropdown-toggle"
                           id="dropdownUser"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">

                            <i class="bi bi-person-circle fs-4"></i>

                            <span class="d-none d-sm-inline mx-2">
                                Usuario
                            </span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-dark text-small shadow"
                            aria-labelledby="dropdownUser">

                            <li>
                                <span class="dropdown-item">Salir</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            @* Contenido principal *@
            <div class="col py-3">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    @* Bootstrap JavaScript para el menú lateral *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>